<Window x:Class="PcfExport.UI.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Fabrication Parts to PCF"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D6B9E"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D6B9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="24,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Output -->
            <RowDefinition Height="Auto"/>  <!-- Pipeline Settings -->
            <RowDefinition Height="Auto"/>  <!-- Selection Mode -->
            <RowDefinition Height="Auto"/>  <!-- Include Options + Compatibility + Connections -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ═══ OUTPUT ═══ -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SectionHeader}" Text="Output Folder *"/>

            <!-- Folder picker (both modes) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding OutputFolderPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,6,0" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Padding="10,3" VerticalAlignment="Center"/>
            </Grid>

            <!-- Single-mode: filename preview + optional override -->
            <StackPanel Visibility="{Binding IsSingleLineNumber, Converter={StaticResource BoolToVis}}"
                        Margin="0,6,0,0">
                <TextBlock FontSize="11" Foreground="#555555"
                           Text="{Binding FilenameHint}"/>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" FontSize="11"
                               Text="Custom Filename"/>
                    <TextBox   Grid.Column="1"
                               Text="{Binding CustomFileName, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="Optional — overrides the Pipeline Reference as the filename. Omit the .pcf extension."/>
                </Grid>
            </StackPanel>

            <!-- Multi-mode: filename note -->
            <TextBlock Visibility="{Binding IsMultipleLineNumbers, Converter={StaticResource BoolToVis}}"
                       FontSize="11" Foreground="#555555" Margin="0,5,0,0"
                       Text="Each PCF file will be named after its line number (e.g. 1001.pcf)."/>
        </StackPanel>

        <!-- ═══ PIPELINE SETTINGS ═══ -->
        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource SectionHeader}" Text="Pipeline Settings"/>

            <!-- Multi-value line number tokens -->
            <Border Margin="0,0,0,8" Padding="8,6" Background="#EFF4FA" CornerRadius="3"
                    Visibility="{Binding IsMultipleLineNumbers, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock FontSize="10" Foreground="#555555" Margin="0,0,0,4"
                               Text="Multiple line numbers detected — click to highlight in model, × to exclude from export:"/>
                    <ItemsControl ItemsSource="{Binding LineNumberTokens}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2,8,2" Padding="4,2" Background="#D6E8F7" CornerRadius="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Display}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="#2D6B9E" TextDecorations="Underline" Cursor="Hand"
                                                   Tag="{Binding}" MouseLeftButtonDown="TokenLink_Click"/>
                                        <Button Content="×" Tag="{Binding}" Click="RemoveToken_Click"
                                                Width="14" Height="14" Margin="4,0,0,0"
                                                Padding="0" FontSize="9" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#666666" Cursor="Hand"
                                                ToolTip="Exclude from export"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>  <!-- Pipeline Reference -->
                    <RowDefinition Height="30"/>  <!-- Spool Identifier -->
                    <RowDefinition Height="30"/>  <!-- Revision -->
                    <RowDefinition Height="30"/>  <!-- Area -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Pipeline Reference *"/>
                <TextBox   Grid.Row="0" Grid.Column="1"
                           Text="{Binding PipelineReference, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Spool Identifier"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                           Text="{Binding SpoolIdentifier, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Defaults to Pipeline Reference if left blank"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Revision"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                           Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="Area"/>
                <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                           Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </StackPanel>

        <!-- ═══ SELECTION MODE ═══ -->
        <StackPanel Grid.Row="2">
            <TextBlock Style="{StaticResource SectionHeader}" Text="Selection"/>
            <RadioButton Content="Use current selection"                                             IsChecked="{Binding ModeCurrentSelection}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Pick elements from model"                                      IsChecked="{Binding ModePickElements}"/>
                <Button Content="Select Elements" Click="PickElements_Click" Padding="8,2" Margin="8,0,0,0"
                        FontSize="11" VerticalAlignment="Center" Cursor="Hand"
                        Visibility="{Binding ModePickElements, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding PickedElementsHint}" Foreground="#555555" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding ModePickElements, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <RadioButton Content="All fabrication parts in active view"                              IsChecked="{Binding ModeAllInView}"/>
        </StackPanel>

        <!-- ═══ INCLUDE OPTIONS ═══ -->
        <StackPanel Grid.Row="3">
            <TextBlock Style="{StaticResource SectionHeader}" Text="Include"/>
            <CheckBox Content="Pipe segments"                                                        IsChecked="{Binding IncludePipes}"/>
            <CheckBox Content="Fittings (elbows, tees, reducers, flanges, valves…)"                 IsChecked="{Binding IncludeFittings}"/>
            <CheckBox Content="Welds"                                                                IsChecked="{Binding IncludeWelds}"/>
            <CheckBox Content="Hangers &amp; supports"                                               IsChecked="{Binding IncludeHangers}"/>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Connections (Flow Direction)"/>
            <TextBlock FontSize="11" Foreground="#555555" Margin="0,0,0,6"
                       Text="Optional — select equipment or pipework to define upstream/downstream connections."/>

            <!-- Connected From -->
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Connected From"/>
                <Button Grid.Column="1" Content="Select" Click="SelectConnectedFrom_Click"
                        Padding="8,2" FontSize="11" Cursor="Hand"/>
                <TextBlock Grid.Column="2" Text="{Binding ConnectedFromText}" FontSize="11"
                           Foreground="#2D6B9E" VerticalAlignment="Center" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="3" Content="x" Click="ClearConnectedFrom_Click"
                        Width="16" Height="16" Padding="0" FontSize="9"
                        Background="Transparent" BorderThickness="0" Foreground="#999999" Cursor="Hand"
                        Visibility="{Binding HasConnectedFrom, Converter={StaticResource BoolToVis}}"
                        ToolTip="Clear"/>
            </Grid>

            <!-- Connected To -->
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Connected To"/>
                <Button Grid.Column="1" Content="Select" Click="SelectConnectedTo_Click"
                        Padding="8,2" FontSize="11" Cursor="Hand"/>
                <TextBlock Grid.Column="2" Text="{Binding ConnectedToText}" FontSize="11"
                           Foreground="#2D6B9E" VerticalAlignment="Center" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="3" Content="x" Click="ClearConnectedTo_Click"
                        Width="16" Height="16" Padding="0" FontSize="9"
                        Background="Transparent" BorderThickness="0" Foreground="#999999" Cursor="Hand"
                        Visibility="{Binding HasConnectedTo, Converter={StaticResource BoolToVis}}"
                        ToolTip="Clear"/>
            </Grid>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Compatibility" Margin="0,8,0,4"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Use standardized descriptions (Plant 3D compatible)"
                          IsChecked="{Binding UseStandardDescriptions}"
                          ToolTip="Reformats ITEM-DESCRIPTION to follow standard naming conventions for Plant 3D PCF to Pipe tool compatibility."/>
                <TextBlock Text="Learn More" Foreground="#2D6B9E" TextDecorations="Underline"
                           Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                           MouseLeftButtonDown="LearnMorePlant3D_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ═══ BUTTONS ═══ -->
        <Border Grid.Row="4" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,16,0,0">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#888888"
                           FontSize="11" Text="{Binding RequiredFieldHint}"/>
                <Button Grid.Column="1" Content="Refresh Selection" Style="{StaticResource SecondaryButton}"
                        Click="Refresh_Click" ToolTip="Re-read the current Revit selection"/>
                <Button Grid.Column="3" Content="Export" Style="{StaticResource PrimaryButton}"
                        Click="Export_Click" IsDefault="True" IsEnabled="{Binding CanExport}"/>
                <Button Grid.Column="5" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
