<Window x:Class="PcfExport.UI.AssignTagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Tag"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D6B9E"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D6B9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="WarnButton" TargetType="Button">
            <Setter Property="Background" Value="#E67E22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <StackPanel Margin="20">

        <!-- ═══ HIGHLIGHT BUTTON ═══ -->
        <Button Content="Highlight Non-Tagged Valves in View"
                Style="{StaticResource WarnButton}"
                HorizontalAlignment="Stretch"
                Click="HighlightNonTagged_Click"
                ToolTip="Selects all valves in the active view that have no Tag value"/>

        <!-- ═══ MODE ═══ -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="Mode"/>
        <RadioButton Content="Manual — pick one valve at a time, type its tag, then accept"
                     Margin="0,2" IsChecked="{Binding IsManualMode}"/>
        <RadioButton Content="Pick in Order — select multiple valves for sequential tagging"
                     Margin="0,2" IsChecked="{Binding IsPickOrderMode}"/>

        <!-- ═══ MANUAL MODE ═══ -->
        <StackPanel Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">

            <TextBlock Style="{StaticResource SectionHeader}" Text="Current Valve"/>

            <!-- Valve card -->
            <Border Background="#E8EEF4" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <!-- Empty state -->
                    <TextBlock Visibility="{Binding HasNoValve, Converter={StaticResource BoolToVis}}"
                               Foreground="#888888" FontSize="11" TextWrapping="Wrap"
                               Text="No valve loaded. Click 'Pick Valve' or use 'Highlight Non-Tagged Valves' to find one."/>
                    <!-- Valve info -->
                    <StackPanel Visibility="{Binding HasCurrentValve, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontWeight="SemiBold" FontSize="12" Text="{Binding CurrentDescription}"/>
                        <TextBlock Foreground="#777777" FontSize="10" Margin="0,2,0,0"
                                   Text="{Binding CurrentUniqueId}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tag input -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" FontWeight="SemiBold" Text="Tag:"/>
                <TextBox Grid.Column="1" x:Name="ManualTagBox"
                         Text="{Binding CurrentTag, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper"
                         Padding="4,3" KeyDown="ManualTagBox_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderBrush" Value="#BBBBBB"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentHasError}" Value="True">
                                    <Setter Property="BorderBrush" Value="#C0392B"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>

            <!-- Error text -->
            <TextBlock Margin="60,3,0,0" FontSize="11" Foreground="#C0392B" TextWrapping="Wrap"
                       Text="{Binding CurrentErrorText}"
                       Visibility="{Binding CurrentHasError, Converter={StaticResource BoolToVis}}"/>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Pick Valve" Style="{StaticResource SecondaryButton}"
                        Click="PickValve_Click" Margin="0,0,6,0"
                        ToolTip="Pick a single valve from the model"/>
                <Button Content="Skip" Style="{StaticResource SecondaryButton}"
                        Click="Skip_Click" Margin="0,0,6,0"
                        IsEnabled="{Binding HasCurrentValve}"
                        ToolTip="Skip this valve and advance to the next untagged one in the view"/>
                <Button Content="Accept" Style="{StaticResource PrimaryButton}"
                        Click="Accept_Click" IsDefault="True"
                        IsEnabled="{Binding CanAccept}"
                        ToolTip="Save tag and advance to next untagged valve"/>
            </StackPanel>
        </StackPanel>

        <!-- ═══ PICK IN ORDER MODE ═══ -->
        <StackPanel Visibility="{Binding IsPickOrderMode, Converter={StaticResource BoolToVis}}">

            <TextBlock Style="{StaticResource SectionHeader}" Text="Sequential Tagging"/>

            <!-- Starting tag -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Starting Tag:"/>
                <TextBox Grid.Column="1" x:Name="StartingTagBox"
                         Text="{Binding StartingTag, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper"
                         ToolTip="e.g. HA-101 — subsequent valves will be HA-102, HA-103, …"/>
            </Grid>

            <!-- Pick button -->
            <Button Content="Pick Valves in Order…" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    Click="PickInOrder_Click"
                    ToolTip="Click valves one by one in the model. Press Enter or Escape when done."/>

            <!-- Preview (visible after picking) -->
            <Border Visibility="{Binding HasPickedItems, Converter={StaticResource BoolToVis}}"
                    Margin="0,8,0,0" Padding="8,6" Background="#EFF4FA" CornerRadius="3">
                <StackPanel>
                    <TextBlock FontSize="11" Text="{Binding PickPreviewText}" TextWrapping="Wrap"/>
                    <TextBlock FontSize="11" Foreground="#C0392B" Margin="0,4,0,0"
                               Text="{Binding PickConflictText}" TextWrapping="Wrap"
                               Visibility="{Binding PickHasConflict, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Pick order action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                        Click="ClearPick_Click" Margin="0,0,6,0"
                        IsEnabled="{Binding HasPickedItems}"/>
                <Button Content="Apply Tags" Style="{StaticResource PrimaryButton}"
                        Click="ApplyPickOrder_Click"
                        IsEnabled="{Binding CanApplyPickOrder}"
                        ToolTip="Write the sequential tags to all picked valves"/>
            </StackPanel>
        </StackPanel>

        <!-- ═══ USED TAGS (collapsible) ═══ -->
        <Border Margin="0,14,0,0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <Button Click="ToggleUsedTags_Click" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#555555" Text="{Binding UsedTagsHeaderText}"/>
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="#555555"
                                   Text="{Binding UsedTagsChevron}" FontFamily="Segoe UI Symbol"/>
                    </Grid>
                </Button>
                <Border Visibility="{Binding IsUsedTagsExpanded, Converter={StaticResource BoolToVis}}"
                        BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                    <ListView ItemsSource="{Binding ExistingTagsSorted}"
                              MaxHeight="160" FontSize="11"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tag" Width="400"
                                                DisplayMemberBinding="{Binding}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ FOOTER ═══ -->
        <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,14,0,0">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                           Foreground="#888888" Text="{Binding StatusText}"/>
                <Button Grid.Column="1" Content="Close" Style="{StaticResource SecondaryButton}"
                        Click="Close_Click" IsCancel="True"/>
            </Grid>
        </Border>

    </StackPanel>
</Window>
